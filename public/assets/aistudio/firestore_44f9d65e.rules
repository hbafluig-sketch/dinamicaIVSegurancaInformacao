rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidParticipation(data) {
      return data.keys().hasAll(['id', 'timestamp', 'factory', 'registrationNumber', 'outcomeType', 'prizeName'])
        && data.id is string && data.id.size() <= 128
        && data.timestamp is number
        && data.factory is string && data.factory.size() > 0 && data.factory.size() <= 64
        && data.registrationNumber is string && data.registrationNumber.size() > 0 && data.registrationNumber.size() <= 64
        && data.outcomeType in ['prize', 'dica']
        && data.prizeName is string && data.prizeName.size() > 0 && data.prizeName.size() <= 128;
    }

    // Participations collection: all company terminals can read, create, and clear history
    match /participations/{participationId} {
      allow read, delete: if true;
      allow create: if isValidId(participationId) && isValidParticipation(incoming());
      allow update: if false;
    }

    // Shared real-time settings (Stock and Roulette Items/Images)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }
  }
}
